APP_NAME=ExternalReceiver
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=external_monitoring
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

HEARTBEAT_HMAC_SECRET=change-me
HEARTBEAT_ALLOWED_DRIFT_SECONDS=300
HEARTBEAT_MAX_BODY_SIZE=100kb
HEARTBEAT_RATE_LIMIT_MAX=120
TIMEOUT_CHECKER_INTERVAL_SECONDS=60
ADMIN_API_TOKEN=

DISCORD_ALERT_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_ALERT_INTERVAL_SECONDS=60
DISCORD_API_BASE_URL=https://discord.com/api/v10
